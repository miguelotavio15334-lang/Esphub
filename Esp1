local function ServerHopFIX()
    local PlaceId = game.PlaceId
    local JobId = game.JobId
    local Players = game.Players
    local TPS = game:GetService("TeleportService")
    local Http = game:GetService("HttpService")
    
    -- Salva o que tava ligado pra voltar ligado
    local saveCode = string.format([[
        getgenv().ESP = %s
        getgenv().RoubarNormal = %s
        getgenv().RoubarFast = %s
        getgenv().HopRoxo = true
    ]], tostring(getgenv().ESP), tostring(getgenv().RoubarNormal), tostring(getgenv().RoubarFast))

    pcall(function()
        queue_on_teleport(saveCode)
        syn.queue_on_teleport(saveCode)
    end)

    -- Pega lista de server
    local servers = {}
    local success, result = pcall(function()
        return Http:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/"..PlaceId.."/servers/Public?sortOrder=Desc&limit=100"))
    end)
    
    if success and result and result.data then
        for _, s in pairs(result.data) do
            if s.id ~= JobId and s.playing < s.maxPlayers - 1 then
                print("Indo pra server: "..s.id)
                TPS:TeleportToPlaceInstance(PlaceId, s.id, Players.LocalPlayer)
                task.wait(2)
                return
            end
        end
    end
    
    -- Se falhar o de cima, tenta o modo 2 que nunca falha
    print("Tentando modo 2 de hop")
    TPS:Teleport(PlaceId, Players.LocalPlayer)
end

