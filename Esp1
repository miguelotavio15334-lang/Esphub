-- SALVA O QUE TAVA LIGADO
getgenv().CiriloSave = getgenv().CiriloSave or {
    ESP = false,
    RoubarNormal = false,
    RoubarFast = false,
    Hop = false
}

getgenv().ESPClown = getgenv().CiriloSave.ESP
getgenv().AutoRoubarNormal = getgenv().CiriloSave.RoubarNormal
getgenv().AutoRoubarFast = getgenv().CiriloSave.RoubarFast
getgenv().AutoHopRoxo = getgenv().CiriloSave.Hop

local status = Instance.new("TextLabel", main)
