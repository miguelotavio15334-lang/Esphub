status.TextColor3 = Color3.fromRGB(150,150,150)
status.BackgroundTransparency = 1
status.Font = Enum.Font.Gotham
status.TextSize = 10

local function saveSettings()
    getgenv().CiriloSave.ESP = getgenv().ESPClown
    getgenv().CiriloSave.RoubarNormal = getgenv().AutoRoubarNormal
    getgenv().CiriloSave.RoubarFast = getgenv().AutoRoubarFast
    getgenv().CiriloSave.Hop = getgenv().AutoHopRoxo
end

local function serverHopRoxo()
    saveSettings()
    local code = [[
        getgenv().CiriloSave = {
            ESP = ]]..tostring(getgenv().ESPClown)..[[,
            RoubarNormal = ]]..tostring(getgenv().AutoRoubarNormal)..[[,
            RoubarFast = ]]..tostring(getgenv().AutoRoubarFast)..[[,
            Hop = true
        }
        loadstring(game:HttpGet("https://raw.githubusercontent.com/CiriloMi/CiriloMi-Hub/main/esp.lua"))()
        -- Se tu usa arquivo local, troca pela loadstring do hub
    ]]
    -- Tenta salvar pra quando teleportar
    pcall(function()
        queue_on_teleport(code)
    end)
    
    local Http = game:GetService("HttpService")
    local TPS = game:GetService("TeleportService")
    local servers = Http:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/"..game.PlaceId.."/servers/Public?sortOrder=Asc&limit=100")).data
    for _,s in pairs(servers) do
        if s.playing < s.maxPlayers and s.id ~= game.JobId then
            TPS:TeleportToPlaceInstance(game.PlaceId, s.id, game.Players.LocalPlayer)
            break
        end
    end
end

-- AUTO LIGA TUDO SE VOLTOU DE HOP
task.spawn(function()
    task.wait(2)
    if getgenv().CiriloSave.Hop then
        status.Text = "Voltou de Hop - Religando tudo..."
        status.TextColor3 = Color3.fromRGB(170,0,255)
        task.wait(1)
        if getgenv().CiriloSave.ESP then getgenv().ESPClown = true end
        if getgenv().CiriloSave.RoubarNormal then getgenv().AutoRoubarNormal = true end
        if getgenv().CiriloSave.RoubarFast then getgenv().AutoRoubarFast = true end
        getgenv().AutoHopRoxo = true
        status.Text = "Tudo religado! Caçando..."
    end
end)

-- LOOP DO HOP ROXO
task.spawn(function()
    while true do task.wait(1)
        if getgenv().AutoHopRoxo then
            local foundGood = false
            pcall(function()
                for _,v in pairs(workspace.Enemies:GetChildren()) do
                    if v.Name:lower():find("clown") and (v.Name:find("600") or v.Name:find("1M")) then
                        foundGood = true
                        status.Text = "ACHOU ".. v.Name .." - PARANDO HOP"
                        status.TextColor3 = Color3.fromRGB(0,255,0)
                        getgenv().AutoHopRoxo = false
                        saveSettings()
                    end
                end
            end)
            if not foundGood then
                status.Text = "Auto Hop ROXO - Trocando em 7s..."
                task.wait(7)
                if getgenv().AutoHopRoxo then serverHopRoxo() end
            end
        end
    end
end)

