-- FUNÇÃO ROUBAR
local function Roubar(mob, fast)
    pcall(function()
        local plr = game.Players.LocalPlayer
        local char = plr.Character
        if not char or not mob:FindFirstChild("HumanoidRootPart") then return end
        
        local prompt = mob:FindFirstChildOfClass("ProximityPrompt", true)
        
        if fast then
            -- RAPIDO 💔
            char.HumanoidRootPart.CFrame = mob.HumanoidRootPart.CFrame * CFrame.new(0,0,2)
            task.wait(0.15)
            if prompt then fireproximityprompt(prompt) end
            -- tenta todos os remotes comuns
            game:GetService("ReplicatedStorage"):FindFirstChild("Remotes") -- tenta chamar
            game.ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("CommF_"):InvokeServer("StealJester")
            game.ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("CommF_"):InvokeServer("StealClown")
        else
            -- NORMAL VERDE
            char.Humanoid:MoveTo(mob.HumanoidRootPart.Position)
            repeat task.wait(0.3) until (char.HumanoidRootPart.Position - mob.HumanoidRootPart.Position).Magnitude < 12
            if prompt then fireproximityprompt(prompt) end
        end
    end)
end

-- FUNÇÃO HOP QUE TROCA MESMO
local function ServerHop()
    local TPS = game:GetService("TeleportService")
    local Http = game:GetService("HttpService")
    local code = string.format("getgenv().ESP=true getgenv().RoubarNormal=%s getgenv().RoubarFast=%s getgenv().HopRoxo=true", tostring(getgenv().RoubarNormal), tostring(getgenv().RoubarFast))
    pcall(function() queue_on_teleport(code) end)
    
    local list = Http:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/"..game.PlaceId.."/servers/Public?sortOrder=Asc&limit=100")).data
    for _,s in pairs(list) do
        if s.id ~= game.JobId and s.playing < s.maxPlayers then
            TPS:TeleportToPlaceInstance(game.PlaceId, s.id, game.Players.LocalPlayer)
            return
        end
    end
    TPS:Teleport(game.PlaceId)
end

-- LOOP PRINCIPAL - ESP + ROUBA + HOP
task.spawn(function()
    while true do task.wait(0.4)
        local achouBom = false
        
        for _,v in pairs(workspace:GetDescendants()) do
            if v:IsA("Model") and v:FindFirstChild("Humanoid") and (v.Name:lower():find("clown") or v.Name:lower():find("jester") or v.Name:lower():find("palha")) then
                
                -- ESP ARCO IRIS NO 1M
                if not v:FindFirstChild("CiriloESP") and getgenv().ESP then
                    local bill = Instance.new("BillboardGui", v)
                    bill.Name = "CiriloESP"
                    bill.Size = UDim2.fromOffset(200,50)
                    bill.StudsOffset = Vector3.new(0,4,0)
                    bill.AlwaysOnTop = true
                    local txt = Instance.new("TextLabel", bill)
                    txt.Size = UDim2.fromOffset(200,50)
                    txt.BackgroundTransparency = 1
                    txt.Text = "🤡 "..v.Name
                    txt.Font = Enum.Font.GothamBold
                    txt.TextSize = 14
                    txt.TextStrokeTransparency = 0
                    if v.Name:find("1M") then
                        task.spawn(function() while txt.Parent do for i=0,1,0.02 do txt.TextColor3 = Color3.fromHSV(i,1,1) task.wait() end end end)
                    else
                        txt.TextColor3 = Color3.new(1,1,1)
                    end
                end

                -- CHECA SE É BOM
                if v.Name:find("600") or v.Name:find("1M") then
                    achouBom = true
                    if getgenv().RoubarFast then Roubar(v, true) end
                    if getgenv().RoubarNormal then Roubar(v, false) end
                end
            end
        end

        -- HOP LOGICA
        if getgenv().HopRoxo and not achouBom then
            ServerHop()
            task.wait(10)
        elseif achouBom and getgenv().HopRoxo then
            getgenv().HopRoxo = false
            game.StarterGui:SetCore("SendNotification", {Title="CiriloMi", Text="ACHOU 600K/1M! Parei o hop", Duration=5})
        end
    end
end)

