-- CIRILOMI - AUTO ROUBAR VERMELHO PEGA O MAIOR DO SERVER
getgenv().RoubarVermelhoMaior = false

local function GetValorDoPalhaco(nome)
    nome = nome:lower()
    if nome:find("1m") or nome:find("1000000") or nome:find("1000k") then return 1000000 end
    if nome:find("600") then return 600000 end
    if nome:find("300") then return 300000 end
    if nome:find("200") then return 200000 end
    if nome:find("150") then return 150000 end
    if nome:find("100") then return 100000 end
    return 0
end

local function RoubarMaior(fast)
    local maior = nil
    local maiorValor = 0

    -- ACHA O MAIOR DO SERVER
    for _,v in pairs(workspace:GetDescendants()) do
        if v:IsA("Model") and v:FindFirstChild("HumanoidRootPart") and v:FindFirstChild("Humanoid") then
            local n = v.Name:lower()
            if n:find("clown") or n:find("jester") or n:find("palha") then
                local valor = GetValorDoPalhaco(v.Name)
                if valor > maiorValor then
                    maiorValor = valor
                    maior = v
                end
            end
        end
    end

    if maior then
        print("Maior palhaço do server: "..maior.Name.." = "..maiorValor)
        pcall(function()
            local char = game.Players.LocalPlayer.Character
            char.HumanoidRootPart.CFrame = maior.HumanoidRootPart.CFrame * CFrame.new(0,0,1.5)
            task.wait(0.2)
            local prompt = maior:FindFirstChildOfClass("ProximityPrompt", true)
            if prompt then fireproximityprompt(prompt) end
            for _,p in pairs(maior:GetDescendants()) do
                if p:IsA("ProximityPrompt") then fireproximityprompt(p) end
            end
            -- Tenta todos os remotes de roubo
            game.ReplicatedStorage.Remotes.CommF_:InvokeServer("StealClown", maior.Name)
            game.ReplicatedStorage.Remotes.CommF_:InvokeServer("StealJester", maior.Name)
        end)
    end
end

-- LOOP DO VERMELHO - PEGA SEMPRE O MAIOR
task.spawn(function()
    while true do task.wait(0.5)
        if getgenv().RoubarVermelhoMaior then
            RoubarMaior(true)
        end
    end
end)

