-- FUNÇÕES
local function getValor(nome)
    if nome:find("1M") then return 1000000 end
    if nome:find("600") then return 600000 end
    if nome:find("300") then return 300000 end
    if nome:find("200") then return 200000 end
    if nome:find("150") then return 150000 end
    if nome:find("100") then return 100000 end
    return 0
end

local function serverHop()
    local TPS = game:GetService("TeleportService")
    local Http = game:GetService("HttpService")
    local PlaceId = game.PlaceId
    pcall(function() queue_on_teleport("getgenv().Hop=true") end)
    local servers = Http:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/"..PlaceId.."/servers/Public?sortOrder=Asc&limit=100")).data
    for _,s in pairs(servers) do
        if s.id ~= game.JobId and s.playing < s.maxPlayers then
            TPS:TeleportToPlaceInstance(PlaceId, s.id, game.Players.LocalPlayer)
            return
        end
    end
    TPS:Teleport(PlaceId)
end

-- LOOP
task.spawn(function()
    while true do task.wait(0.5)
        local maior = nil
        local maiorValor = 0
        for _,v in pairs(workspace:GetDescendants()) do
            if v:IsA("Model") and v:FindFirstChild("HumanoidRootPart") and v:FindFirstChild("Humanoid") then
                if v.Name:lower():find("clown") or v.Name:lower():find("jester") or v.Name:lower():find("palha") then
                    local val = getValor(v.Name)
                    if val > maiorValor then maiorValor = val maior = v end
                end
            end
        end
        if maior then
            if getgenv().RoubarMaior then -- VERMELHO PEGA MAIOR
                pcall(function()
                    game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = maior.HumanoidRootPart.CFrame * CFrame.new(0,0,2)
                    task.wait(0.2)
                    local pr = maior:FindFirstChildOfClass("ProximityPrompt", true)
                    if pr then fireproximityprompt(pr) end
                end)
            elseif getgenv().RoubarNormal and maiorValor >= 100000 then
                pcall(function()
                    game.Players.LocalPlayer.Character.Humanoid:MoveTo(maior.HumanoidRootPart.Position)
                end)
            end
            if getgenv().Hop and maiorValor >= 600000 then
                getgenv().Hop = false
                status.Text = "ACHOU "..maior.Name.." - PAROU"
            end
        else
            if getgenv().Hop then serverHop() task.wait(8) end
        end
    end
end)

