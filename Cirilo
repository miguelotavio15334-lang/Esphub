-- FUNÇÃO FILTEK - TUDO NO MÁXIMO
local function filtekCarro(car)
	status.Text = "🔍 Escaneando..."
	
	local chassis = car:FindFirstChild("A-Chassis", true) or car:FindFirstChild("AChassis", true)
	if not chassis then 
		status.Text = "❌ Não é A-Chassis"
		return 
	end
	
	local tune = chassis:FindFirstChild("Tune") or car:FindFirstChild("Tune", true)
	if not tune then
		status.Text = "❌ Sem pasta Tune"
		return
	end
	
	status.Text = "💉 INJETANDO..."
	
	-- TUDO NO TALO - PRESSÃO, IGNIÇÃO, ROTAÇÃO
	pcall(function()
		-- MOTOR / POTÊNCIA MÁXIMA
		if tune:FindFirstChild("Horsepower") then tune.Horsepower.Value = 5000 end
		if tune:FindFirstChild("Torque") then tune.Torque.Value = 8000 end
		if tune:FindFirstChild("MaxRPM") then tune.MaxRPM.Value = 12000 end -- rotação máxima
		if tune:FindFirstChild("IdleRPM") then tune.IdleRPM.Value = 1500 end
		if tune:FindFirstChild("Redline") then tune.Redline.Value = 11500 end
		
		-- TURBO NO MÁXIMO - PRESSÃO
		if tune:FindFirstChild("TurboCharged") then tune.TurboCharged.Value = true end
		if tune:FindFirstChild("Turbo") then tune.Turbo.Value = true end
		if tune:FindFirstChild("TurboBoost") then tune.TurboBoost.Value = 80 end -- pressão do turbo
		if tune:FindFirstChild("TurboPiping") then tune.TurboPiping.Value = true end
		if tune:FindFirstChild("Boost") then tune.Boost.Value = 80 end
		
		-- IGNIÇÃO E INJEÇÃO
		if tune:FindFirstChild("Ignition") then tune.Ignition.Value = true end
		if tune:FindFirstChild("IgnTiming") then tune.IgnTiming.Value = 35 end
		if tune:FindFirstChild("FuelInject") then tune.FuelInject.Value = true end
		
		-- PESO E GRIP - DEIXA LEVE E NÃO ESCORREGA
		if tune:FindFirstChild("Weight") then tune.Weight.Value = 1200 end -- mais leve
		if tune:FindFirstChild("WeightDist") then tune.WeightDist.Value = 50 end
		if tune:FindFirstChild("TireGrip") then tune.TireGrip.Value = 3.5 end
		if tune:FindFirstChild("BrakePower") then tune.BrakePower.Value = 10000 end
		if tune:FindFirstChild("MaxSpeed") then tune.MaxSpeed.Value = 500 end
		
		-- TRANSMISSÃO - TROCA RÁPIDA
		if tune:FindFirstChild("ShiftTime") then tune.ShiftTime.Value = 0.05 end
	end)
	
	status.Text = "✅ FILTEKADO! 5000HP"
	btn.Text = "✅ NO MÁXIMO!"
	btn.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
	wait(2)
	btn.Text = "💉 FILTEK TURBO"
	btn.BackgroundColor3 = Color3.fromRGB(255, 80, 0)
	status.Text = "Pronto pra correr"
end

btn.MouseButton1Click:Connect(function()
	local char = player.Character
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum and hum.SeatPart then
		local car = hum.SeatPart:FindFirstAncestorOfClass("Model")
		if car then
			filtekCarro(car)
		else
			status.Text = "❌ Senta no banco!"
		end
	else
		status.Text = "❌ ENTRA NO CARRO!"
	end
end)
