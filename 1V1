UIS.InputBegan:Connect(function(i,gp)
    if gp then return end
    if i.KeyCode==Enum.KeyCode.M then toggleGUI()
    elseif i.KeyCode==Enum.KeyCode.R then pausado=not pausado bStatus.Text=pausado and "PAUSADO [R]" or "STATUS: Procurando..."
    elseif i.KeyCode==Enum.KeyCode.T then
        local b,v=temPalhaco100k()
        if b then
            if modoTP==2 or modoTP==3 then
                LP.Character.HumanoidRootPart.CFrame=b.PrimaryPart.CFrame+Vector3.new(0,0,2)
            end
        end
    end
end)

