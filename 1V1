-- Mx V1 - HOP FORÇADO QUE TROCA SIM - DELTA/FLUXUS FIX
getgenv().Visitados = getgenv().Visitados or {}

local LP = game.Players.LocalPlayer
local TS = game:GetService("TeleportService")
local SG = game.StarterGui

local function hopFORCADO()
    SG:SetCore("SendNotification",{Title="🔄 TROCANDO AGORA", Text="FORÇANDO SAIDA DESSE SERVER!", Duration=1})
    table.insert(getgenv().Visitados, game.JobId)
    
    -- 1 SEGUNDO PRA GARANTIR QUE SALVOU
    task.wait(0.5)
    
    -- JEITO QUE FUNCIONA EM TODO EXECUTOR
    local PlaceId = game.PlaceId
    
    -- TENTA 5 VEZES DIFERENTE
    pcall(function() TS:Teleport(PlaceId, LP) end)
    task.wait(0.3)
    pcall(function() TS:Teleport(PlaceId) end)
    task.wait(0.3)
    pcall(function() 
        local args = {game.PlaceId}
        TS:Teleport(unpack(args))
    end)
    task.wait(0.3)
    -- ULTIMO RECURSO - SE NADA FUNCIONAR, KICKA E VAI
    LP:Kick("TROCANDO DE SERVER...")
    task.wait(0.5)
    TS:Teleport(PlaceId, LP)
end

-- SE TU APERTAR R ELE TROCA NA HORA PRA TESTAR
game:GetService("UserInputService").InputBegan:Connect(function(i,gp)
    if gp then return end
    if i.KeyCode == Enum.KeyCode.R then
        hopFORCADO()
    end
end)

-- LOOP QUE TROCA A CADA 4 SEGUNDOS SE NÃO ACHAR 100K
local Plots = workspace:WaitForChild("Plots")

local function tem100k()
    for _,plot in pairs(Plots:GetChildren()) do
        if plot:FindFirstChild("Owner") and plot.Owner.Value ~= LP.Name then
            for _,m in pairs(plot:GetChildren()) do
                if m:IsA("Model") and m:FindFirstChild("PricePerSecond") then
                    if m.PricePerSecond.Value >= 100000 then
                        return true
                    end
                end
            end
        end
    end
    return false
end

SG:SetCore("SendNotification",{Title="Mx FORÇADO", Text="Aperta R pra TESTAR o hop agora! Se achar 100K para", Duration=5})

task.spawn(function()
    while true do
        task.wait(4)
        if not tem100k() then
            hopFORCADO()
        end
    end
end)
