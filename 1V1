local function getValor(name)
    local n = name:lower()
    if n:find("secret") or n:find("1m") or n:find("10m") then return 10000000 end
    if n:find("god") or n:find("mythic") then return 5000000 end
    if n:find("legendary") then return 1000000 end
    if n:find("epic") then return 500000 end
    if n:find("rare") then return 100000 end
    return 10000
end

local function getCor(v)
    if v >= 10000000 then return Color3.fromRGB(255,215,0) end
    if v >= 5000000 then return Color3.fromRGB(255,0,0) end
    if v >= 1000000 then return Color3.fromRGB(130,0,255) end
    if v >= 500000 then return Color3.fromRGB(0,150,255) end
    return Color3.new(1,1,1)
end

local function hop()
    status.Text = "Trocando de server..."
    local code = 'getgenv().BrainV2.Hop=true getgenv().BrainV2.ESP=true getgenv().BrainV2.Vermelho=true'
    pcall(function() queue_on_teleport(code) end)
    local id = game.PlaceId
    local ok,res = pcall(function() return game.HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/"..id.."/servers/Public?sortOrder=Asc&limit=100")) end)
    if ok and res.data then
        for _,s in pairs(res.data) do if s.id ~= game.JobId and s.playing < s.maxPlayers-1 then TPS:TeleportToPlaceInstance(id,s.id,LP) return end end
    end
    TPS:Teleport(id)
end

task.spawn(function()
    while true do task.wait(0.35)
        local melhor, melhorV = nil, 0
        for _,m in pairs(workspace:GetDescendants()) do
            if m:IsA("Model") and m:FindFirstChild("HumanoidRootPart") and (m.Name:lower():find("brainrot") or m.Parent.Name:lower():find("plot") or m:FindFirstChild("Price")) then
                -- Tenta pegar valor real do jogo
                local v = getValor(m.Name)
                pcall(function()
                    if m:FindFirstChild("Price") then v = tonumber(m.Price.Value) or v end
                    if m:FindFirstChild("Rarity") then v = getValor(m.Rarity.Value) end
                end)
                if v > melhorV then melhorV = v melhor = m end

                if getgenv().BrainV2.ESP and not m:FindFirstChild("ESP_Brain") then
                    local bg = Instance.new("BillboardGui", m)
                    bg.Name = "ESP_Brain"
                    bg.Size = UDim2.new(0,220,0,40)
                    bg.StudsOffset = Vector3.new(0,4,0)
                    bg.AlwaysOnTop = true
                    local lb = Instance.new("TextLabel", bg)
                    lb.Size = UDim2.new(1,0,1,0)
                    lb.BackgroundTransparency = 1
                    lb.Text = "🧠 "..m.Name.." - "..melhorV/1000.."K/s"
                    lb.TextColor3 = getCor(v)
                    lb.TextStrokeTransparency = 0
                    lb.Font = Enum.Font.GothamBold
                    lb.TextSize = 11
                    if v >= 5000000 then
                        task.spawn(function() while lb.Parent do for i=0,1,0.02 do lb.TextColor3 = Color3.fromHSV(i,1,1) task.wait() end end end)
                    end
                end
            end
        end

        if melhor then
            if getgenv().BrainV2.Vermelho then
                status.Text = "Roubando MAIOR: "..melhor.Name
                pcall(function()
                    LP.Character.HumanoidRootPart.CFrame = melhor.HumanoidRootPart.CFrame * CFrame.new(0,0,2)
                    task.wait(0.25)
                    for _,p in pairs(melhor:GetDescendants()) do if p:IsA("ProximityPrompt") then fireproximityprompt(p) end end
                    -- Remotes comuns do Steal a Brainrot
                    game.ReplicatedStorage:FindFirstChild("StealRemote") and game.ReplicatedStorage.StealRemote:FireServer(melhor)
                end)
            elseif getgenv().BrainV2.Normal then
                status.Text = "Roubando: "..melhor.Name
                pcall(function() LP.Character.Humanoid:MoveTo(melhor.HumanoidRootPart.Position) end)
            end

            if getgenv().BrainV2.Hop and melhorV >= 1000000 then
                status.Text = "ACHOU RARO! "..melhor.Name
                getgenv().BrainV2.Hop = false
            end
        else
            if getgenv().BrainV2.Hop then hop() task.wait(7) end
        end
    end
end)

