local function ServerHop()
    table.insert(getgenv().Visitados, game.JobId)
    notify("Mx V1","🔄 Trocando e NÃO volta no mesmo!",3)

    -- TENTA ACHAR SERVER NOVO QUE NÃO VISITOU
    local servers = {}
    local ok, result = pcall(function()
        return Http:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/"..game.PlaceId.."/servers/Public?sortOrder=Asc&limit=100"))
    end)

    if ok and result and result.data then
        for _,s in pairs(result.data) do
            if s.id ~= game.JobId and s.playing < s.maxPlayers then
                local jaFoi = false
                for _,v in pairs(getgenv().Visitados) do if v==s.id then jaFoi=true break end end
                if not jaFoi then table.insert(servers, s.id) end
            end
        end
    end

    if #servers > 0 then
        local idEscolhido = servers[math.random(1,#servers)]
        pcall(function() TS:TeleportToPlaceInstance(game.PlaceId, idEscolhido, LP) end)
    else
        -- Se não achou lista, limpa visitados se tiver muito e teleport normal
        if #getgenv().Visitados > 20 then getgenv().Visitados = {} end
        pcall(function() TS:Teleport(game.PlaceId, LP) end)
    end
    task.wait(1)
    pcall(function() TS:Teleport(game.PlaceId, LP) end) -- fallback
end

