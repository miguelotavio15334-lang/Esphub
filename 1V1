-- LOGICA
local function getValor(name)
    local n = name:lower()
    if n:find("1m") or n:find("1000") then return 1000000 end
    if n:find("600") then return 600000 end
    if n:find("300") then return 300000 end
    if n:find("200") then return 200000 end
    if n:find("150") then return 150000 end
    if n:find("100") then return 100000 end
    return 0
end

local function getCor(valor)
    if valor >= 1000000 then return Color3.fromRGB(255,0,255) end
    if valor >= 600000 then return Color3.fromRGB(255,140,0) end
    if valor >= 300000 then return Color3.fromRGB(130,0,255) end
    if valor >= 200000 then return Color3.fromRGB(0,150,255) end
    if valor >= 150000 then return Color3.fromRGB(0,255,0) end
    return Color3.new(1,1,1)
end

local function hop()
    status.Text = "Status: Trocando server..."
    local code = 'getgenv().CiriloV2.Hop=true getgenv().CiriloV2.ESP=true getgenv().CiriloV2.Vermelho=true'
    pcall(function() queue_on_teleport(code) syn.queue_on_teleport(code) end)
    local id = game.PlaceId
    local ok, res = pcall(function()
        return game.HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/"..id.."/servers/Public?sortOrder=Asc&limit=100"))
    end)
    if ok and res.data then
        for _,s in pairs(res.data) do
            if s.id ~= game.JobId and s.playing < s.maxPlayers-1 then
                TPS:TeleportToPlaceInstance(id, s.id, LocalPlayer)
                return
            end
        end
    end
    TPS:Teleport(id)
end

-- LOOP PRINCIPAL
task.spawn(function()
    while true do task.wait(0.3)
        local melhor = nil
        local melhorValor = 0
        local lista = {}

        for _,m in pairs(workspace:GetDescendants()) do
            if m:IsA("Model") and m:FindFirstChild("HumanoidRootPart") and m:FindFirstChild("Humanoid") then
                if m.Name:lower():find("clown") or m.Name:lower():find("jester") or m.Name:lower():find("palha") then
                    local v = getValor(m.Name)
                    table.insert(lista, {model=m, valor=v})
                    if v > melhorValor then melhorValor = v melhor = m end

                    -- ESP
                    if getgenv().CiriloV2.ESP and not m:FindFirstChild("ESP_Cirilo") then
                        local bg = Instance.new("BillboardGui", m)
                        bg.Name = "ESP_Cirilo"
                        bg.Size = UDim2.new(0,200,0,50)
                        bg.StudsOffset = Vector3.new(0,4,0)
                        bg.AlwaysOnTop = true
                        local lb = Instance.new("TextLabel", bg)
                        lb.Size = UDim2.new(1,0,1,0)
                        lb.BackgroundTransparency = 1
                        lb.Text = "🤡 "..m.Name.." 💰"..v/1000.."K"
                        lb.TextColor3 = getCor(v)
                        lb.TextStrokeTransparency = 0
                        lb.Font = Enum.Font.GothamBold
                        lb.TextSize = 13
                        if v >= 1000000 then
                            task.spawn(function()
                                while lb.Parent do
                                    for i=0,1,0.02 do lb.TextColor3 = Color3.fromHSV(i,1,1) task.wait() end
                                end
                            end)
                        end
                    end
                end
            end
        end

        -- AUTO ROUBAR
        if melhor then
            if getgenv().CiriloV2.Vermelho then -- VERMELHO PEGA MAIOR
                status.Text = "Roubando MAIOR: "..melhor.Name
                pcall(function()
                    LocalPlayer.Character.HumanoidRootPart.CFrame = melhor.HumanoidRootPart.CFrame * CFrame.new(0,0,1.5)
                    task.wait(0.25)
                    for _,p in pairs(melhor:GetDescendants()) do if p:IsA("ProximityPrompt") then fireproximityprompt(p) end end
                end)
            elseif getgenv().CiriloV2.Normal then
                status.Text = "Roubando Normal: "..melhor.Name
                pcall(function()
                    LocalPlayer.Character.Humanoid:MoveTo(melhor.HumanoidRootPart.Position)
                end)
            end

            if getgenv().CiriloV2.Hop and melhorValor >= 600000 then
                status.Text = "ACHOU "..melhorValor/1000.."K! PAROU HOP"
                getgenv().CiriloV2.Hop = false
            end
        else
            if getgenv().CiriloV2.Hop then hop() task.wait(7) end
        end
    end
end)

